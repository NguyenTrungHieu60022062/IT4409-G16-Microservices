# Copy thành file .env (đã được .gitignore) rồi điền giá trị thật:
#   cp .env.example .env
# Mật khẩu DB: chuỗi ngẫu nhiên dài, vd tạo bằng:  openssl rand -base64 24
AUTH_DB_PASSWORD=doi-thanh-chuoi-ngau-nhien-dai
USER_DB_PASSWORD=doi-thanh-chuoi-ngau-nhien-khac

# Khoá AES-256 mã hoá số điện thoại (32 byte, base64). Tạo bằng: openssl rand -base64 32
# MẤT KHOÁ = MẤT DỮ LIỆU đã mã hoá. Lộ khoá = lộ dữ liệu. Không commit, không gửi qua chat.
USER_PII_KEY=

# Origin của frontend được phép gọi API (cách nhau bằng dấu phẩy)
FRONTEND_ORIGIN=http://localhost:5173

# Tạo quản trị viên ĐẦU TIÊN: đăng ký tài khoản bình thường, điền email đó vào đây, khởi động lại
# auth-service, rồi XOÁ giá trị này đi. Chỉ có tác dụng khi hệ thống chưa có ADMIN nào.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
